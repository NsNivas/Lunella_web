<style>
/* ==========================================
   1. GLOBAL STYLES
========================================== */
:root {
    --bg: #0b1020;
    --card: #151c30;
    --text: #f3f4f6;
    --muted: #a0aec0;
    --primary: #8b5cf6;
    --secondary: #06b6d4;
    --border: rgba(255,255,255,0.1);
    --shadow: 0 10px 35px rgba(0,0,0,0.2);
}

body.light {
    --bg: #f5f7ff;
    --card: #ffffff;
    --text: #172033;
    --muted: #596579;
    --border: rgba(0,0,0,0.1);
    --shadow: 0 10px 35px rgba(0,0,0,0.08);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    transition: background 0.3s, color 0.3s;
}

a {
    text-decoration: none;
    color: inherit;
}

button, input, textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

.container {
    width: 90%;
    max-width: 1150px;
    margin: auto;
}

section {
    padding: 90px 0;
}

.section-title {
    text-align: center;
    font-size: 2.4rem;
    margin-bottom: 12px;
}

.section-title span {
    color: var(--primary);
}

.section-description {
    text-align: center;
    color: var(--muted);
    max-width: 650px;
    margin: 0 auto 45px;
}

.btn {
    display: inline-block;
    border: none;
    padding: 12px 25px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white;
    font-weight: bold;
    transition: transform 0.3s, box-shadow 0.3s;
}

.btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(139,92,246,0.3);
}

.outline-btn {
    background: transparent;
    border: 1px solid var(--primary);
    color: var(--text);
}

.highlight {
    color: var(--primary);
}

/* ==========================================
   2. NAVIGATION BAR
========================================== */
header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
}

.navbar {
    min-height: 75px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 1.7rem;
    font-weight: 800;
}

.logo span {
    color: var(--primary);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 25px;
    list-style: none;
}

.nav-links a {
    color: var(--muted);
    transition: color 0.3s;
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--primary);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.theme-toggle,
.menu-toggle {
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 9px 12px;
    border-radius: 8px;
}

.menu-toggle {
    display: none;
}

/* ==========================================
   3. HERO SECTION
========================================== */
.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 120px;
    background:
        radial-gradient(circle at 80% 30%,
        rgba(139,92,246,0.12), transparent 35%);
}

.hero-content {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 50px;
}

.eyebrow {
    color: var(--secondary);
    font-weight: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-size: 0.85rem;
}

.hero h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.15;
    margin: 18px 0;
}

.hero h2 {
    font-size: 1.5rem;
    margin-bottom: 18px;
    color: var(--muted);
}

.hero p {
    color: var(--muted);
    max-width: 600px;
    margin-bottom: 25px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.social-links {
    display: flex;
    gap: 15px;
    margin-top: 30px;
}

.social-links a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--border);
    border-radius: 50%;
    transition: 0.3s;
}

.social-links a:hover {
    background: var(--primary);
    transform: translateY(-4px);
}

.hero-visual {
    display: flex;
    justify-content: center;
}

.profile-card {
    width: min(100%, 340px);
    padding: 35px;
    text-align: center;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 25px;
    box-shadow: var(--shadow);
    animation: float 4s ease-in-out infinite;
}

.profile-avatar {
    width: 180px;
    height: 180px;
    margin: 0 auto 20px;
    display: grid;
    place-items: center;
    font-size: 4rem;
    font-weight: bold;
    color: white;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    border: 6px solid rgba(139,92,246,0.2);
}

.profile-card h3 {
    font-size: 1.5rem;
}

.profile-card p {
    margin: 5px 0 15px;
}

.status {
    display: inline-block;
    background: rgba(34,197,94,0.12);
    color: #22c55e;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
}

/* ==========================================
   4. ABOUT SECTION
========================================== */
.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
    align-items: center;
}

.about-card {
    background: var(--card);
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: 15px;
}

.about-card h3 {
    margin-bottom: 15px;
    font-size: 1.5rem;
}

.about-card p {
    color: var(--muted);
    margin-bottom: 15px;
}

.about-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-top: 25px;
}

.detail-item {
    padding: 15px;
    background: var(--bg);
    border-radius: 10px;
}

.detail-item strong {
    display: block;
    color: var(--primary);
    font-size: 0.9rem;
}

.detail-item span {
    overflow-wrap: anywhere;
}

/* ==========================================
   5. SKILLS SECTION
========================================== */
.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.skill-card {
    padding: 25px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 15px;
    transition: transform 0.3s, border-color 0.3s;
}

.skill-card:hover {
    transform: translateY(-6px);
    border-color: var(--primary);
}

.skill-icon {
    font-size: 2rem;
    margin-bottom: 12px;
}

.skill-card h3 {
    margin-bottom: 15px;
}

.skill-info {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 8px;
}

.skill-bar {
    height: 8px;
    background: var(--bg);
    border-radius: 20px;
    overflow: hidden;
}

.skill-progress {
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    border-radius: 20px;
    transition: width 1.5s ease;
}

/* ==========================================
   6. PROJECTS SECTION
========================================== */
.projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.project-card {
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 15px;
    transition: transform 0.3s;
}

.project-card:hover {
    transform: translateY(-8px);
}

.project-banner {
    min-height: 150px;
    display: grid;
    place-items: center;
    font-size: 3.5rem;
    background: linear-gradient(135deg,
        rgba(139,92,246,0.3),
        rgba(6,182,212,0.2));
}

.project-content {
    padding: 23px;
}

.project-content h3 {
    margin-bottom: 10px;
}

.project-content p {
    color: var(--muted);
    margin-bottom: 18px;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
}

.tag {
    padding: 4px 9px;
    border-radius: 5px;
    background: var(--bg);
    color: var(--secondary);
    font-size: 0.8rem;
}

.project-links {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.project-links a {
    color: var(--primary);
    font-weight: bold;
}

/* ==========================================
   7. EXPERIENCE SECTION
========================================== */
.timeline {
    max-width: 750px;
    margin: auto;
    border-left: 2px solid var(--primary);
    padding-left: 30px;
}

.timeline-item {
    position: relative;
    margin-bottom: 35px;
    padding: 25px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
}

.timeline-item::before {
    content: "";
    position: absolute;
    left: -39px;
    top: 30px;
    width: 14px;
    height: 14px;
    background: var(--primary);
    border: 3px solid var(--bg);
    border-radius: 50%;
}

.timeline-item .date {
    color: var(--secondary);
    font-size: 0.9rem;
    font-weight: bold;
}

.timeline-item h3 {
    margin: 8px 0;
}

.timeline-item p {
    color: var(--muted);
}

/* ==========================================
   8. CONTACT SECTION
========================================== */
.contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 35px;
}

.contact-info,
.contact-form {
    padding: 30px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 15px;
}

.contact-info h3,
.contact-form h3 {
    margin-bottom: 20px;
    font-size: 1.4rem;
}

.contact-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 20px;
}

.contact-item .icon {
    font-size: 1.5rem;
}

.contact-item p {
    color: var(--muted);
}

.form-group {
    margin-bottom: 18px;
}

.form-group label {
    display: block;
    margin-bottom: 7px;
    font-weight: bold;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    outline: none;
    background: var(--bg);
    color: var(--text);
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: var(--primary);
}

.form-group textarea {
    min-height: 130px;
    resize: vertical;
}

.form-message {
    margin-top: 15px;
    color: var(--secondary);
}

/* ==========================================
   9. FOOTER
========================================== */
footer {
    border-top: 1px solid var(--border);
    padding: 25px 0;
    text-align: center;
    color: var(--muted);
}

footer a {
    color: var(--primary);
}

.footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    flex-wrap: wrap;
}

/* ==========================================
   10. SCROLL ANIMATIONS
========================================== */
.reveal {
    opacity: 0;
    transform: translateY(25px);
    transition: opacity 0.7s, transform 0.7s;
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}

.back-to-top {
    position: fixed;
    right: 25px;
    bottom: 25px;
    width: 45px;
    height: 45px;
    display: none;
    place-items: center;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 1.4rem;
    z-index: 999;
}

.back-to-top.show {
    display: grid;
}

/* ==========================================
   11. RESPONSIVE DESIGN
========================================== */
@media (max-width: 900px) {
    .hero-content {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .hero p {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons,
    .social-links {
        justify-content: center;
    }

    .hero-visual {
        margin-top: 20px;
    }

    .about-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .skills-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .projects-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .nav-links {
        gap: 15px;
    }
}

@media (max-width: 650px) {
    section {
        padding: 65px 0;
    }

    .section-title {
        font-size: 2rem;
    }

    .menu-toggle {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 75px;
        left: 0;
        width: 100%;
        padding: 20px;
        background: var(--card);
        border-bottom: 1px solid var(--border);
        flex-direction: column;
        align-items: stretch;
    }

    .nav-links.open {
        display: flex;
    }

    .nav-links a {
        display: block;
        padding: 8px;
    }

    .skills-grid,
    .projects-grid {
        grid-template-columns: 1fr;
    }

    .about-details {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 2.6rem;
    }

    .hero h2 {
        font-size: 1.2rem;
    }

    .profile-card {
        padding: 25px;
    }

    .profile-avatar {
        width: 145px;
        height: 145px;
    }

    .contact-info,
    .contact-form,
    .about-card {
        padding: 22px;
    }

    .footer-content {
        justify-content: center;
        text-align: center;
    }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }
}
</style>
</head>

